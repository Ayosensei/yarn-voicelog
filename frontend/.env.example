# Frontend Production / Staging Environment Variables

# URL of the deployed FastAPI backend (e.g. https://yarn-backend.onrender.com)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# Supabase Project URL (from Supabase Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase Anonymous Public Key (safe for client-side browser usage)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
