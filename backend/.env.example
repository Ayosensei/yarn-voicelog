# Yarn VoiceLog Backend - Environment Variables Template
# Copy this file to .env and fill in your real values:
#   copy .env.example .env

# Google Gemini API Key (free from https://aistudio.google.com/apikey)
GEMINI_API_KEY=paste-your-key-here

# Supabase (get from Person C / Femi)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key

# OpenAI / Whisper (optional, for audio file fallback)
OPENAI_API_KEY=

# Fernet encryption key for BYOK (auto-generated if left empty)
FERNET_SECRET_KEY=
